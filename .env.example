# Public site URL used for canonical links and the sitemap.
PUBLIC_SITE_URL=https://cryptocards.biz

# Rybbit analytics (optional). The script is served first-party via /analytics/*.
# RYBBIT_HOST is server-side (used by the proxy route); the site id is public.
RYBBIT_HOST=https://analytics.cryptocards.biz
PUBLIC_RYBBIT_SITE_ID=
