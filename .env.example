# Public site URL used for canonical links and the sitemap.
PUBLIC_SITE_URL=https://cryptocards.biz

# Self-hosted Umami analytics (optional). The script is served first-party
# via /stats/* (proxied to UMAMI_HOST).
# UMAMI_HOST is server-side (used by the proxy route) -> runtime env, restart only.
UMAMI_HOST=https://an.cryptocards.biz
# PUBLIC_UMAMI_WEBSITE_ID is inlined at BUILD time. In Coolify set it as a
# "Build Variable"; locally export it before `npm run build` (or pass --build-arg).
PUBLIC_UMAMI_WEBSITE_ID=

# Card "Get card" links (server-side). A JSON map of card slug -> URL.
# Overrides the built-in official provider link, so you can change any link
# without rebuilding. Paste official or affiliate URLs (no ?ref= needed).
# Example:
# CARD_LINKS={"redotpay-card":"https://www.redotpay.com/","kolo-card":"https://kolo.xyz/"}
CARD_LINKS={}

# Admin panel (/admin) for editing affiliate links and promo codes. Server-side,
# runtime env. The panel is disabled unless ADMIN_PASSWORD is 12+ characters.
ADMIN_PASSWORD=
# Saves are committed to GitHub so the push rebuilds the site. Use a
# fine-grained token limited to this repo with "Contents: Read and write".
GITHUB_TOKEN=
GITHUB_REPO=owner/cryptocards.biz
# The branch your deployment builds from.
GITHUB_BRANCH=main
# Cloudflare Turnstile "human check" on the admin login. Active once the secret
# key is set (Cloudflare dashboard -> Turnstile -> your widget -> Secret key).
# The site key defaults to the cryptocards.biz widget; override only if it changes.
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
# Hostnames Cloudflare must report for a valid token (comma-separated).
# Defaults to cryptocards.biz,www.cryptocards.biz. Never add localhost in production.
TURNSTILE_HOSTNAMES=
# Optional: call a deploy webhook after each save (e.g. Coolify's deploy URL
# + API token) if pushes do not redeploy automatically.
DEPLOY_HOOK_URL=
DEPLOY_HOOK_TOKEN=
