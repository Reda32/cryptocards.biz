# Public site URL used for canonical links and the sitemap.
PUBLIC_SITE_URL=https://cryptocards.biz

# Self-hosted Umami analytics (optional). The script is served first-party
# via /stats/* (proxied to UMAMI_HOST).
# UMAMI_HOST is server-side (used by the proxy route) -> runtime env, restart only.
UMAMI_HOST=https://an.cryptocards.biz
# PUBLIC_UMAMI_WEBSITE_ID is inlined at BUILD time. In Coolify set it as a
# "Build Variable"; locally export it before `npm run build` (or pass --build-arg).
PUBLIC_UMAMI_WEBSITE_ID=

# Card "Get card" links (server-side). A JSON map of card slug -> URL.
# Overrides the built-in official provider link, so you can change any link
# without rebuilding. Paste official or affiliate URLs (no ?ref= needed).
# Example:
# CARD_LINKS={"redotpay-card":"https://www.redotpay.com/","kolo-card":"https://kolo.xyz/"}
CARD_LINKS={}
