---
import SeoHead from './SeoHead.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import PromoBanner from './PromoBanner.astro';
import CompareBar from './islands/CompareBar.tsx';
import { getCompareCards } from '@/lib/cards';
import { allPairSlugs } from '@/lib/pairs';
import { getCollection } from 'astro:content';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  schemas?: Record<string, unknown>[];
  /** 'full' embeds every card's data (for the /compare table); 'minimal' only
   *  what the compare bar needs, keeping pages small. */
  comparePayload?: 'minimal' | 'full';
}

const { comparePayload = 'minimal', ...props } = Astro.props;

const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;

const allCards = await getCompareCards();
const cards =
  comparePayload === 'full'
    ? allCards
    : allCards.map(({ slug, name, logo, brandColor }) => ({ slug, name, logo, brandColor }));
const payload = JSON.stringify({ cards, pairs: allPairSlugs() });

// Promo banner: copy is derived from the card data so it can't drift.
const PROMO_SLUG = 'kast-card';
const promoDismissKey = `promo:${PROMO_SLUG}:dismissed`;
const promoEntry = (await getCollection('cards')).find((c) => c.data.slug === PROMO_SLUG);
const promo = promoEntry
  ? (() => {
      const d = promoEntry.data;
      const coins = d.cryptos.slice(0, 2).map((c) => c.symbol).join(' & ');
      const cashback = d.rewards?.cashback ?? 'crypto rewards';
      const instant = d.type.includes('virtual') ? ', and an instant virtual card' : '';
      return {
        slug: d.slug,
        name: d.name,
        logo: d.logo,
        color: d.brandColor,
        message: `Spend ${coins} with the ${d.name} — ${cashback}${instant}.`,
        short: cashback,
      };
    })()
  : null;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#020617" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Apply the saved theme before paint to avoid a flash of the wrong theme.
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var isDark = stored
            ? stored === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', isDark);
        } catch (e) {}
      })();
    </script>
    <SeoHead {...props} />
    <script
      is:inline
      set:html={`(function(){try{if(localStorage.getItem(${JSON.stringify(promoDismissKey)})==='1'){document.documentElement.classList.add('promo-dismissed');}}catch(e){}})();`}
    />
    {
      umamiWebsiteId && (
        <script is:inline defer src="/stats/script.js" data-website-id={umamiWebsiteId}></script>
      )
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    {promo && <PromoBanner {...promo} />}
    <main class="flex-1 pb-24">
      <slot />
    </main>
    <Footer />

    <script type="application/json" id="compare-data" is:inline set:html={payload} />
    <CompareBar client:load />
  </body>
</html>
