---
import QRCode from 'qrcode';

interface Props {
  slug: string;
  caption?: string;
  size?: number;
}

const { slug, caption = 'Scan to get this card on your phone', size = 160 } = Astro.props;

const site = Astro.site ?? new URL('https://cryptocards.biz');
const target = new URL(`/go/${slug}`, site).href;

// Generated at build time; inlined as an SVG so there is no client JS.
const svg = await QRCode.toString(target, {
  type: 'svg',
  margin: 1,
  width: size,
  errorCorrectionLevel: 'M',
  color: { dark: '#0f172a', light: '#ffffff' },
});
---

<figure class="flex flex-col items-center gap-3 text-center">
  <div
    class="rounded-xl bg-white p-2 ring-1 ring-slate-200 dark:ring-slate-700 [&>svg]:block [&>svg]:h-auto [&>svg]:w-full"
    style={`width:${size}px;max-width:100%`}
    role="img"
    aria-label={`QR code to get this card on your phone`}
    set:html={svg}
  />
  <figcaption class="max-w-[13rem] text-xs text-slate-500 dark:text-slate-400">{caption}</figcaption>
</figure>
