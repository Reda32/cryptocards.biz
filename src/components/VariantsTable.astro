---
import { usd } from '@/lib/types';

interface Variant {
  name: string;
  price?: number;
  rewards: string;
  monthlyFee: number;
  limits: string;
  cardInfo: string;
}

interface Props {
  variants: Variant[];
}
const { variants } = Astro.props;
---

<div class="card-surface overflow-x-auto">
  <table class="w-full min-w-[640px] text-sm">
    <thead>
      <tr class="border-b border-slate-200 bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500 dark:border-slate-800 dark:bg-slate-900/50">
        <th class="px-5 py-3 font-medium">Feature</th>
        {
          variants.map((variant) => (
            <th class="px-5 py-3 font-semibold text-slate-900 dark:text-white">{variant.name}</th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      <tr class="border-b border-slate-100 dark:border-slate-800/60">
        <td class="px-5 py-2.5 text-slate-500 dark:text-slate-400">One-off price</td>
        {variants.map((variant) => <td class="px-5 py-2.5 font-medium">{usd(variant.price)}</td>)}
      </tr>
      <tr class="border-b border-slate-100 dark:border-slate-800/60">
        <td class="px-5 py-2.5 text-slate-500 dark:text-slate-400">Monthly fee</td>
        {variants.map((variant) => <td class="px-5 py-2.5">{usd(variant.monthlyFee)}</td>)}
      </tr>
      <tr class="border-b border-slate-100 dark:border-slate-800/60">
        <td class="px-5 py-2.5 text-slate-500 dark:text-slate-400">Rewards</td>
        {variants.map((variant) => <td class="px-5 py-2.5">{variant.rewards}</td>)}
      </tr>
      <tr class="border-b border-slate-100 dark:border-slate-800/60">
        <td class="px-5 py-2.5 text-slate-500 dark:text-slate-400">Limits</td>
        {variants.map((variant) => <td class="px-5 py-2.5">{variant.limits}</td>)}
      </tr>
      <tr>
        <td class="px-5 py-2.5 text-slate-500 dark:text-slate-400">Card</td>
        {variants.map((variant) => <td class="px-5 py-2.5">{variant.cardInfo}</td>)}
      </tr>
    </tbody>
  </table>
</div>
