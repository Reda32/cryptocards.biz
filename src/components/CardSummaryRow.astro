---
import CardLogo from './CardLogo.astro';
import CtaButton from './CtaButton.astro';
import CompareToggle from './CompareToggle.astro';
import { KYC_LABELS, type Card } from '@/lib/cards';

interface Props {
  card: Card;
  communityScore?: number | null;
}

const { card, communityScore = null } = Astro.props;
const d = card.data;

const networkLabel = d.network === 'visa' ? 'Visa' : 'Mastercard';
const typeLabel = d.type.map((t) => (t === 'virtual' ? 'Virtual' : 'Physical')).join(' + ');
---

<article class="card-surface flex flex-col gap-5 p-5 sm:flex-row sm:items-center">
  <div class="flex flex-1 items-start gap-4">
    <CardLogo src={d.logo} name={d.name} color={d.brandColor} size={48} />
    <div class="min-w-0">
      <h3 class="text-base font-bold text-slate-900 dark:text-white">
        <a href={`/cards/${d.slug}`} class="hover:text-brand-600 dark:hover:text-brand-400">{d.name}</a>
      </h3>
      <div class="mt-1.5 flex flex-wrap gap-1.5">
        <span class="badge bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300">{networkLabel}</span>
        <span class="badge bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300">{typeLabel}</span>
        <span class="badge bg-sky-100 text-sky-800 dark:bg-sky-950 dark:text-sky-300">{KYC_LABELS[d.kyc.level]}</span>
      </div>
      <p class="mt-2 line-clamp-2 text-sm text-slate-500 dark:text-slate-400">{d.summary}</p>
    </div>
  </div>

  <div class="flex items-center gap-6 sm:flex-col sm:items-end sm:gap-2">
    <div class="text-right">
      <p class="text-xs uppercase tracking-wide text-slate-400">Overall</p>
      <p class="text-xl font-bold tabular-nums text-slate-900 dark:text-white">{d.rating.toFixed(1)}</p>
    </div>
    <div class="text-right">
      <p class="text-xs uppercase tracking-wide text-slate-400">Community</p>
      <p class="text-xl font-bold tabular-nums text-slate-900 dark:text-white">
        {communityScore !== null ? communityScore.toFixed(1) : '—'}
      </p>
    </div>
  </div>

  <div class="flex flex-col items-stretch gap-2 sm:w-40">
    <CtaButton slug={d.slug} label="Get card" />
    <CompareToggle slug={d.slug} />
  </div>
</article>
