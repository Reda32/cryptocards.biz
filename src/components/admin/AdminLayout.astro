---
import '@/styles/global.css';

interface Props {
  title: string;
  signedIn?: boolean;
}

const { title, signedIn = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · CryptoCards admin</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      } catch {}
    </script>
  </head>
  <body class="min-h-screen">
    <header class="border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
      <div class="container-page flex h-14 items-center justify-between gap-4">
        <a href="/admin" class="font-bold text-slate-900 dark:text-white">CryptoCards admin</a>
        {
          signedIn && (
            <div class="flex items-center gap-3">
              <a href="/" class="text-sm text-slate-500 hover:underline dark:text-slate-400">
                View site
              </a>
              <form method="post" action="/admin/logout">
                <button type="submit" class="btn-secondary">
                  Log out
                </button>
              </form>
            </div>
          )
        }
      </div>
    </header>
    <main class="container-page py-8">
      <slot />
    </main>
  </body>
</html>
