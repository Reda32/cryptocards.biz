---
import { cryptoIcon, networkIcon } from '@/lib/icons';

interface Props {
  cryptos: { symbol: string; networks: string[] }[];
}

const { cryptos } = Astro.props;

const items = cryptos.map((crypto) => ({
  symbol: crypto.symbol,
  icon: cryptoIcon(crypto.symbol),
  networks: crypto.networks.map((name) => ({ name, icon: networkIcon(name) })),
}));
---

<ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
  {
    items.map((crypto) => (
      <li class="card-surface flex items-start gap-3 p-4">
        {crypto.icon ? (
          <img
            src={crypto.icon}
            alt=""
            width="40"
            height="40"
            loading="lazy"
            decoding="async"
            class="h-10 w-10 shrink-0 rounded-full"
          />
        ) : (
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-slate-900 text-xs font-bold text-white dark:bg-slate-700">
            {crypto.symbol.slice(0, 4)}
          </span>
        )}
        <div>
          <p class="text-sm font-semibold text-slate-900 dark:text-white">{crypto.symbol}</p>
          <div class="mt-1 flex flex-wrap gap-1">
            {crypto.networks.map((network) => (
              <span class="badge gap-1 bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                {network.icon && (
                  <img
                    src={network.icon}
                    alt=""
                    width="12"
                    height="12"
                    loading="lazy"
                    decoding="async"
                    class="h-3 w-3 rounded-full"
                  />
                )}
                {network.name}
              </span>
            ))}
          </div>
        </div>
      </li>
    ))
  }
</ul>
