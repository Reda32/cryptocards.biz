---
interface Props {
  slug: string;
  label?: string;
  class?: string;
}
const { slug, label = 'Compare', class: className = '' } = Astro.props;
---

<label
  class:list={[
    'inline-flex cursor-pointer select-none items-center gap-2 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 transition hover:border-brand-400 hover:text-brand-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300',
    className,
  ]}
>
  <input
    type="checkbox"
    data-compare-slug={slug}
    class="h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500"
  />
  <span>{label}</span>
</label>
