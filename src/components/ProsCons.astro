---
import Icon from '@/components/ui/Icon.astro';

interface Props {
  pros: string[];
  cons: string[];
}
const { pros, cons } = Astro.props;
---

<div class="grid gap-4 sm:grid-cols-2">
  <div class="card-surface p-5">
    <h3 class="mb-3 flex items-center gap-2 text-sm font-bold text-emerald-700 dark:text-emerald-400">
      <span class="grid h-5 w-5 place-items-center rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-400">
        <Icon name="check" size={12} />
      </span>
      Pros
    </h3>
    <ul class="space-y-2 text-sm">
      {
        pros.map((item) => (
          <li class="flex gap-2">
            <span class="mt-0.5 text-emerald-600 dark:text-emerald-400" aria-hidden="true">+</span>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="card-surface p-5">
    <h3 class="mb-3 flex items-center gap-2 text-sm font-bold text-rose-700 dark:text-rose-400">
      <span class="grid h-5 w-5 place-items-center rounded-full bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-400">
        <Icon name="x" size={12} />
      </span>
      Cons
    </h3>
    <ul class="space-y-2 text-sm">
      {
        cons.map((item) => (
          <li class="flex gap-2">
            <span class="mt-0.5 text-rose-600 dark:text-rose-400" aria-hidden="true">−</span>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
