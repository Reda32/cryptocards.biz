---
const year = new Date().getFullYear();
const columns = [
  {
    title: 'Cards',
    links: [
      { href: '/cards', label: 'All card reviews' },
      { href: '/coupons', label: 'Promo codes & coupons' },
      { href: '/compare', label: 'Compare cards' },
      { href: '/best', label: 'Best-of lists' },
      { href: '/countries', label: 'By country' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/about', label: 'About us' },
      { href: '/methodology', label: 'Methodology' },
      { href: '/contact', label: 'Contact' },
      { href: '/affiliate-disclosure', label: 'Affiliate disclosure' },
      { href: '/privacy', label: 'Privacy policy' },
      { href: '/terms', label: 'Terms of use' },
    ],
  },
];
---

<footer class="border-t border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950">
  <div class="container-page py-12">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <div class="flex items-center gap-2 font-bold text-slate-900 dark:text-white">
          <img src="/favicon.svg" alt="" width="28" height="28" />
          <span>CryptoCards<span class="text-brand-600 dark:text-brand-400">.biz</span></span>
        </div>
        <p class="mt-3 max-w-sm text-sm text-slate-500 dark:text-slate-400">
          Independent reviews and side-by-side comparisons of crypto cards. We may earn a
          commission from some links. Not financial advice.
        </p>
        <div class="mt-4 flex items-center gap-3">
          <a
            href="https://x.com/Cryptocardsbiz"
            target="_blank"
            rel="noopener"
            aria-label="CryptoCards.biz on X"
            class="inline-flex items-center gap-2 rounded-lg border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:border-brand-400 hover:text-brand-600 dark:border-slate-800 dark:text-slate-300 dark:hover:border-brand-500 dark:hover:text-brand-400"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117l11.966 15.644Z" />
            </svg>
            Follow on X
          </a>
        </div>
      </div>
      {
        columns.map((column) => (
          <div>
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white">{column.title}</h3>
            <ul class="mt-3 space-y-2 text-sm">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-slate-500 hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-400"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div
      class="mt-10 flex flex-col gap-2 border-t border-slate-200 pt-6 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between dark:border-slate-800 dark:text-slate-400"
    >
      <p>© {year} CryptoCards.biz. All rights reserved.</p>
      <p>
        Information is provided for general information only and may be out of date. Always verify
        fees and terms with the provider.
      </p>
    </div>
  </div>
</footer>
