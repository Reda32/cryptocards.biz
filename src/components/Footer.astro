---
const year = new Date().getFullYear();
const columns = [
  {
    title: 'Cards',
    links: [
      { href: '/cards', label: 'All card reviews' },
      { href: '/coupons', label: 'Promo codes & coupons' },
      { href: '/compare', label: 'Compare cards' },
      { href: '/best', label: 'Best-of lists' },
      { href: '/countries', label: 'By country' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/methodology', label: 'Methodology' },
      { href: '/affiliate-disclosure', label: 'Affiliate disclosure' },
      { href: '/privacy', label: 'Privacy policy' },
      { href: '/terms', label: 'Terms of use' },
    ],
  },
];
---

<footer class="border-t border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950">
  <div class="container-page py-12">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <div class="flex items-center gap-2 font-bold text-slate-900 dark:text-white">
          <img src="/favicon.svg" alt="" width="28" height="28" />
          <span>CryptoCards<span class="text-brand-600 dark:text-brand-400">.biz</span></span>
        </div>
        <p class="mt-3 max-w-sm text-sm text-slate-500 dark:text-slate-400">
          Independent reviews and side-by-side comparisons of crypto cards. We may earn a
          commission from some links. Not financial advice.
        </p>
      </div>
      {
        columns.map((column) => (
          <div>
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white">{column.title}</h3>
            <ul class="mt-3 space-y-2 text-sm">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-slate-500 hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-400"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div
      class="mt-10 flex flex-col gap-2 border-t border-slate-200 pt-6 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between dark:border-slate-800 dark:text-slate-400"
    >
      <p>© {year} CryptoCards.biz. All rights reserved.</p>
      <p>
        Information is provided for general information only and may be out of date. Always verify
        fees and terms with the provider.
      </p>
    </div>
  </div>
</footer>
