---
interface Props {
  items: { question: string; answer: string }[];
  schema?: boolean;
}

const { items, schema = true } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<div class="space-y-2">
  {
    items.map((item) => (
      <details class="card-surface group overflow-hidden">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-4 font-semibold text-slate-900 dark:text-white">
          {item.question}
          <span class="text-slate-400 transition group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <p class="border-t border-slate-100 p-4 text-sm text-slate-600 dark:border-slate-800 dark:text-slate-300">
          {item.answer}
        </p>
      </details>
    ))
  }
</div>

{
  schema && items.length > 0 && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  )
}
