---
interface Props {
  score: number | null;
  label?: string;
  size?: number;
  /** Show the "/10" suffix under the number. */
  outOf?: boolean;
}

const { score, label, size = 72, outOf = false } = Astro.props;

function colorFor(value: number | null): string {
  if (value === null) return '#94a3b8';
  if (value >= 8.5) return '#059669';
  if (value >= 7) return '#1f42f5';
  if (value >= 6) return '#d97706';
  return '#e11d48';
}

const color = colorFor(score);
const pct = score === null ? 0 : Math.max(0, Math.min(100, (score / 10) * 100));
const inner = size - 16;
---

<div class="flex items-center gap-3">
  <div
    class="relative grid shrink-0 place-items-center rounded-full"
    style={`width:${size}px;height:${size}px;background:conic-gradient(${color} ${pct * 3.6}deg, #e2e8f0 0deg)`}
    role="img"
    aria-label={score === null ? 'No score yet' : `Score ${score} out of 10`}
  >
    <div
      class="grid place-items-center rounded-full bg-white text-center dark:bg-slate-900"
      style={`width:${inner}px;height:${inner}px`}
    >
      {
        score === null ? (
          <span class="text-xs font-semibold text-slate-400">N/A</span>
        ) : (
          <span>
            <span
              class="block font-bold tabular-nums text-slate-900 dark:text-white"
              style={`font-size:${Math.round(size * 0.3)}px;line-height:1`}
            >
              {score.toFixed(1)}
            </span>
            {outOf && <span class="block text-[10px] text-slate-400">/ 10</span>}
          </span>
        )
      }
    </div>
  </div>
  {label && <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">{label}</span>}
</div>
