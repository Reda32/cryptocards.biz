---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/components/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CardHeader from '@/components/CardHeader.astro';
import Disclosure from '@/components/Disclosure.astro';
import ProsCons from '@/components/ProsCons.astro';
import KycBlock from '@/components/KycBlock.astro';
import CryptoList from '@/components/CryptoList.astro';
import FeesTable from '@/components/FeesTable.astro';
import CommunityScore from '@/components/CommunityScore.astro';
import VariantsTable from '@/components/VariantsTable.astro';
import FaqSection from '@/components/FaqSection.astro';
import Section from '@/components/Section.astro';
import CardSummaryRow from '@/components/CardSummaryRow.astro';
import CtaButton from '@/components/CtaButton.astro';
import CardQr from '@/components/CardQr.astro';
import {
  getAllCards,
  getCommunityForCard,
  getReviewForCard,
  featureLabel,
  formatIsoDate,
  KYC_LABELS,
} from '@/lib/cards';
import { slugify } from '@/lib/taxonomy';
import { CURATED_PAIRS, pairSlug } from '@/lib/pairs';

export async function getStaticPaths() {
  const cards = await getCollection('cards');
  return cards.map((card) => ({ params: { slug: card.data.slug }, props: { card } }));
}

const { card } = Astro.props;
const d = card.data;

const [community, review, allCards] = await Promise.all([
  getCommunityForCard(d.slug),
  getReviewForCard(d.slug),
  getAllCards(),
]);

const ReviewContent = review ? (await render(review)).Content : null;

const comparisons = CURATED_PAIRS.filter(
  (pair) => pair.a === d.slug || pair.b === d.slug,
).map((pair) => {
  const otherSlug = pair.a === d.slug ? pair.b : pair.a;
  const other = allCards.find((c) => c.data.slug === otherSlug);
  return {
    href: `/compare/${pairSlug(pair.a, pair.b)}`,
    label: other ? `${d.name} vs ${other.data.name}` : 'Comparison',
  };
});

const others = allCards.filter((c) => c.data.slug !== d.slug).slice(0, 6);

const shownCountries = d.countries.slice(0, 12);
const moreCountries = Math.max(0, d.countries.length - shownCountries.length);

const stepForKyc =
  !d.kyc || d.kyc.level === 'none'
    ? 'No identity check is required before you can use the card.'
    : `Complete verification: ${KYC_LABELS[d.kyc.level]}. ${d.kyc.notes ?? ''}`.trim();

const defaultSteps = [
  d.referral
    ? `Open the ${d.name} sign-up page using our link below.`
    : `Open the ${d.name} sign-up page on the provider's website.`,
  `Create your account with an email${d.kyc?.phone ? ' and phone number' : ''}.`,
  ...(d.referral
    ? [`Enter the referral code ${d.referral.code} if it is not already applied.`]
    : []),
  stepForKyc,
  'Make your first top-up and start spending.',
];
const howToSteps = d.howToGet.length > 0 ? d.howToGet : defaultSteps;

const toc = [
  { id: 'overview', label: 'Overview' },
  { id: 'fees', label: 'Fees' },
  { id: 'limits', label: 'Limits' },
  { id: 'kyc', label: 'KYC / verification' },
  { id: 'countries', label: 'Supported countries' },
  { id: 'availability', label: 'Card availability' },
  { id: 'features', label: 'Features' },
  { id: 'cryptos', label: 'Supported cryptocurrencies' },
  ...(d.variants.length > 0 ? [{ id: 'variants', label: 'Variants' }] : []),
  ...(community ? [{ id: 'community', label: 'Community sentiment' }] : []),
  ...(d.pros.length > 0 || d.cons.length > 0
    ? [{ id: 'pros-cons', label: 'Pros & limitations' }]
    : []),
  { id: 'how-to-get', label: 'How to get the card' },
  ...(ReviewContent ? [{ id: 'review', label: 'Full review' }] : []),
  ...(d.faq.length > 0 ? [{ id: 'faq', label: 'FAQ' }] : []),
];

const reviewSchema = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  itemReviewed: {
    '@type': 'Product',
    name: d.name,
    brand: { '@type': 'Brand', name: d.company },
    category: 'Crypto card',
  },
  author: { '@type': 'Organization', name: 'CryptoCards.biz' },
  publisher: { '@type': 'Organization', name: 'CryptoCards.biz' },
  ...(d.rating !== null && d.rating !== undefined
    ? {
        reviewRating: {
          '@type': 'Rating',
          ratingValue: d.rating,
          bestRating: 10,
          worstRating: 0,
        },
      }
    : {}),
  datePublished: formatIsoDate(d.lastVerified),
  dateModified: formatIsoDate(d.lastVerified),
  reviewBody: d.summary,
};

// Only emit Review structured data for human-verified cards with a score.
const schemas = d.verified && d.rating !== null && d.rating !== undefined ? [reviewSchema] : [];
---

<BaseLayout
  title={`${d.name} Review 2026: Fees, Limits, KYC & Supported Countries`}
  description={`${d.summary} Read our verdict, fees, limits, KYC requirements and supported countries for the ${d.name}.`}
  image={`/og/${d.slug}.png`}
  type="article"
  modifiedTime={d.lastVerified}
  noindex={!d.verified}
  schemas={schemas}
>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Cards', href: '/cards' },
      { label: d.name },
    ]}
  />

  <div class="container-page mt-4 space-y-10">
    <CardHeader card={card} communityScore={community?.data.score ?? null} />

    <Disclosure />

    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_16rem]">
      <div class="min-w-0 space-y-12">
        <Section id="overview" title="Overview">
          <p class="text-slate-600 dark:text-slate-300">
            {d.summary}
            {d.rating !== null && d.rating !== undefined ? (
              <>
                {' '}Our editorial score is <strong>{d.rating.toFixed(1)}/10</strong>, based on fees,
                limits, supported coins, KYC friction and day-to-day usability.
              </>
            ) : (
              <>
                {' '}Our editorial score and full assessment are pending verification for this card.
              </>
            )}
          </p>
        </Section>

        <Section id="fees" title="Fees">
          <FeesTable fees={d.fees} limits={d.limits} rewards={d.rewards} show={['fees', 'rewards']} />
        </Section>

        <Section id="limits" title="Limits">
          <FeesTable fees={d.fees} limits={d.limits} rewards={d.rewards} show={['limits']} />
        </Section>

        <Section id="kyc" title="KYC / verification">
          <KycBlock kyc={d.kyc} />
        </Section>

        <Section id="countries" title="Supported countries">
          {
            d.countries.length > 0 ? (
              <>
                <p class="mb-4 text-slate-600 dark:text-slate-300">
                  The {d.name} is available in {d.countries.length} countries and regions we track.
                  See the full list, restrictions and residency requirements on the dedicated page.
                </p>
                <ul class="flex flex-wrap gap-2">
                  {shownCountries.map((country) => (
                    <li>
                      <a
                        href={`/countries/${slugify(country)}`}
                        class="badge bg-slate-100 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200"
                      >
                        {country}
                      </a>
                    </li>
                  ))}
                  {moreCountries > 0 && (
                    <li>
                      <a
                        href={`/cards/${d.slug}/countries`}
                        class="badge bg-brand-50 text-brand-700 hover:bg-brand-100 dark:bg-brand-950/40 dark:text-brand-300"
                      >
                        +{moreCountries} more
                      </a>
                    </li>
                  )}
                </ul>
              </>
            ) : (
              <p class="text-sm text-slate-500 dark:text-slate-400">
                We have not confirmed the supported-country list yet.
              </p>
            )
          }
          <a
            href={`/cards/${d.slug}/countries`}
            class="mt-4 inline-block text-sm font-medium text-brand-600 hover:underline dark:text-brand-400"
          >
            See all supported countries →
          </a>
        </Section>

        <Section id="availability" title="Card availability">
          <ul class="grid gap-3 sm:grid-cols-2">
            <li class="card-surface flex items-center justify-between p-4 text-sm">
              <span class="text-slate-500 dark:text-slate-400">Card type</span>
              <span class="font-medium text-slate-900 dark:text-white">
                {d.type.length > 0
                  ? d.type.map((t) => (t === 'virtual' ? 'Virtual' : 'Physical')).join(' + ')
                  : 'Not disclosed'}
              </span>
            </li>
            <li class="card-surface flex items-center justify-between p-4 text-sm">
              <span class="text-slate-500 dark:text-slate-400">Network</span>
              <span class="font-medium text-slate-900 dark:text-white">
                {d.network === 'visa' ? 'Visa' : d.network === 'mastercard' ? 'Mastercard' : 'Not disclosed'}
              </span>
            </li>
            <li class="card-surface flex items-center justify-between p-4 text-sm">
              <span class="text-slate-500 dark:text-slate-400">Mobile wallets</span>
              <span class="font-medium text-slate-900 dark:text-white">
                {d.wallets.length > 0
                  ? d.wallets.map((w) => (w === 'apple' ? 'Apple Pay' : 'Google Pay')).join(', ')
                  : 'None'}
              </span>
            </li>
            <li class="card-surface flex items-center justify-between p-4 text-sm">
              <span class="text-slate-500 dark:text-slate-400">Restricted regions</span>
              <span class="text-right font-medium text-slate-900 dark:text-white">
                {d.restrictedCountries.length > 0 ? d.restrictedCountries.length : 'None documented'}
              </span>
            </li>
          </ul>
          {
            d.availabilityNotes && (
              <p class="mt-4 rounded-lg bg-slate-50 p-4 text-sm text-slate-600 dark:bg-slate-900/50 dark:text-slate-300">
                {d.availabilityNotes}
              </p>
            )
          }
        </Section>

        <Section id="features" title="Features">
          <ul class="grid gap-3 sm:grid-cols-2">
            {
              d.features.map((feature) => (
                <li class="flex items-center gap-3 rounded-lg border border-slate-200 bg-white p-3 text-sm dark:border-slate-800 dark:bg-slate-900">
                  <span class="grid h-6 w-6 place-items-center rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-400">
                    ✓
                  </span>
                  {featureLabel(feature)}
                </li>
              ))
            }
            {
              d.wallets.map((wallet) => (
                <li class="flex items-center gap-3 rounded-lg border border-slate-200 bg-white p-3 text-sm dark:border-slate-800 dark:bg-slate-900">
                  <span class="grid h-6 w-6 place-items-center rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-400">
                    ✓
                  </span>
                  {wallet === 'apple' ? 'Apple Pay' : 'Google Pay'}
                </li>
              ))
            }
          </ul>
        </Section>

        <Section id="cryptos" title="Supported cryptocurrencies">
          <CryptoList cryptos={d.cryptos} />
        </Section>

        {
          d.variants.length > 0 && (
            <Section id="variants" title="Variants">
              <VariantsTable variants={d.variants} />
            </Section>
          )
        }

        {
          community && (
            <Section id="community" title="Community sentiment">
              <CommunityScore
                score={community.data.score}
                sources={community.data.sources}
                summary={community.data.summary}
                updatedAt={community.data.updatedAt}
                categories={community.data.categories}
              />
            </Section>
          )
        }

        {
          (d.pros.length > 0 || d.cons.length > 0) && (
            <Section id="pros-cons" title="Pros & limitations">
              <ProsCons pros={d.pros} cons={d.cons} />
            </Section>
          )
        }

        <Section id="how-to-get" title="How to get the card">
          <ol class="space-y-4">
            {
              howToSteps.map((step, index) => (
                <li class="flex gap-4">
                  <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-brand-600 text-sm font-bold text-white">
                    {index + 1}
                  </span>
                  <p class="pt-1 text-slate-600 dark:text-slate-300">{step}</p>
                </li>
              ))
            }
          </ol>
          <div class="mt-5 flex flex-wrap items-center gap-3">
            {d.referral ? (
              <CtaButton slug={d.slug} label={`Get the ${d.name}`} variant="accent" />
            ) : (
              <span class="text-sm text-slate-500 dark:text-slate-400">
                No verified sign-up link yet.
              </span>
            )}
            <a href={`/coupons/${d.slug}`} class="btn-secondary">See promo codes</a>
          </div>
        </Section>

        {
          ReviewContent && (
            <Section id="review" title="Our full review">
              <div class="prose-page text-slate-600 dark:text-slate-300">
                <ReviewContent />
              </div>
            </Section>
          )
        }

        {
          d.faq.length > 0 && (
            <Section id="faq" title="Frequently asked questions">
              <FaqSection items={d.faq} />
            </Section>
          )
        }

        <section
          id="promo"
          class="scroll-mt-24 rounded-xl border border-brand-200 bg-brand-50 p-6 dark:border-brand-900 dark:bg-brand-950/40"
        >
          <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
            {d.name} promo code
          </h2>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
            {d.referral ? (
              <>Use code <strong class="font-mono">{d.referral.code}</strong> — {d.referral.bonus}</>
            ) : (
              'No verified promo code or referral bonus is available for this card yet.'
            )}
          </p>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <a href={`/coupons/${d.slug}`} class="btn-primary">View promo codes & coupons</a>
            <a href={`/cards/${d.slug}/countries`} class="btn-secondary">Available countries</a>
          </div>
        </section>

        <section class="rounded-xl border border-slate-200 bg-slate-50 p-5 text-xs text-slate-500 dark:border-slate-800 dark:bg-slate-900/50 dark:text-slate-400">
          <p>
            Last verified {d.lastVerified.toISOString().slice(0, 10)}. Fees, limits and availability
            change frequently — always confirm the current terms with {d.company} before applying.
            This is not financial advice.
          </p>
        </section>

        {
          others.length > 0 && (
            <Section id="related" title="Compare with other cards">
              <div class="space-y-4">
                {others.map((other) => (
                  <CardSummaryRow card={other} />
                ))}
              </div>
            </Section>
          )
        }
      </div>

      <aside class="min-w-0 space-y-6 lg:sticky lg:top-24 lg:self-start">
        <div class="card-surface p-5">
          <h2 class="mb-2 text-sm font-bold text-slate-900 dark:text-white">Promo codes & coupons</h2>
          <p class="mb-3 text-sm text-slate-500 dark:text-slate-400">
            {d.referral ? d.referral.bonus : 'No verified promo code yet.'}
          </p>
          <a href={`/coupons/${d.slug}`} class="btn-primary w-full">Get the bonus</a>
        </div>

        {
          d.referral && (
            <div class="card-surface hidden p-5 lg:block">
              <CardQr slug={d.slug} />
            </div>
          )
        }

        <div class="card-surface p-5">
          <h2 class="mb-2 text-sm font-bold text-slate-900 dark:text-white">Available countries</h2>
          <p class="mb-3 text-sm text-slate-500 dark:text-slate-400">
            {d.countries.length} supported
            {d.restrictedCountries.length > 0 ? ` · ${d.restrictedCountries.length} restricted` : ''}
          </p>
          <a href={`/cards/${d.slug}/countries`} class="btn-secondary w-full">See all countries</a>
        </div>

        <nav class="card-surface p-5 text-sm" aria-label="On this page">
          <h2 class="mb-3 text-xs font-bold uppercase tracking-wide text-slate-400">On this page</h2>
          <ul class="space-y-2">
            {
              toc.map((item) => (
                <li>
                  <a href={`#${item.id}`} class="text-slate-600 hover:text-brand-600 dark:text-slate-300 dark:hover:text-brand-400">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        {
          comparisons.length > 0 && (
            <div class="card-surface p-5">
              <h2 class="mb-2 text-sm font-bold text-slate-900 dark:text-white">Head-to-head</h2>
              <ul class="space-y-2 text-sm">
                {comparisons.map((item) => (
                  <li>
                    <a href={item.href} class="text-brand-600 hover:underline dark:text-brand-400">
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <div class="card-surface p-5">
          <h2 class="mb-2 text-sm font-bold text-slate-900 dark:text-white">Available in</h2>
          <ul class="flex flex-wrap gap-1.5">
            {d.countries.slice(0, 8).map((country) => (
              <li>
                <a
                  href={`/countries/${slugify(country)}`}
                  class="badge bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300"
                >
                  {country}
                </a>
              </li>
            ))}
          </ul>
          <a
            href={`/cards/${d.slug}/countries`}
            class="mt-3 inline-block text-xs font-medium text-brand-600 hover:underline dark:text-brand-400"
          >
            +{Math.max(0, d.countries.length - 8)} more →
          </a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
