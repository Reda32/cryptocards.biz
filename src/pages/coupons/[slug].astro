---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CardLogo from '@/components/CardLogo.astro';
import CtaButton from '@/components/CtaButton.astro';
import FeesTable from '@/components/FeesTable.astro';
import CopyCodeButton from '@/components/islands/CopyCodeButton.tsx';
import Disclosure from '@/components/Disclosure.astro';
import { KYC_LABELS, formatIsoDate, formatDate } from '@/lib/cards';

export async function getStaticPaths() {
  const cards = await getCollection('cards');
  return cards.map((card) => ({ params: { slug: card.data.slug }, props: { card } }));
}

const { card } = Astro.props;
const d = card.data;
const hasOffer = Boolean(d.referral);

const kycStep = !d.kyc
  ? 'Complete the verification steps the provider asks for.'
  : d.kyc.level === 'none'
    ? 'No identity check is required before you can use the card.'
    : `Complete identity verification: ${KYC_LABELS[d.kyc.level]} is required. ${d.kyc.notes ?? ''}`.trim();

const steps = hasOffer
  ? [
      'Open the sign-up page using our link below — the code is usually pre-filled.',
      `Create your account with an email${d.kyc?.phone ? ' and phone number' : ''}.`,
      `Enter the promo code ${d.referral!.code} if it is not already applied.`,
      kycStep,
      'Make a first top-up to trigger the reward.',
    ]
  : [
      'Open the provider app or website and start sign-up.',
      `Create your account with an email${d.kyc?.phone ? ' and phone number' : ''}.`,
      kycStep,
      'Fund your card or account.',
      'Start spending.',
    ];

const whatYouGet = [
  d.referral?.bonus,
  d.rewards?.cashback
    ? `Ongoing cashback: ${d.rewards.cashback}${d.rewards.cashbackToken ? ` in ${d.rewards.cashbackToken}` : ''}.`
    : null,
  d.rewards?.welcomeBonus ? `Welcome bonus: ${d.rewards.welcomeBonus}.` : null,
].filter((item): item is string => Boolean(item));

const eligibility =
  d.referral?.eligibility ??
  `New ${d.company} users who sign up and meet the verification level for the card.`;

const expiryLabel =
  d.referral?.expiry ??
  'No promotion is currently published. Promotions can be added or withdrawn at any time.';

const expiryDate =
  d.referral?.expiry && !Number.isNaN(Date.parse(d.referral.expiry))
    ? new Date(d.referral.expiry)
    : null;

const faq = hasOffer
  ? [
      {
        question: `What is the ${d.name} promo code?`,
        answer: `The current ${d.name} promo code is ${d.referral!.code}. It is applied during sign-up and unlocks: ${d.referral!.bonus}`,
      },
      {
        question: `What do I get with the ${d.name} promo code?`,
        answer: whatYouGet.join(' ') || d.referral!.bonus,
      },
      {
        question: `Who is eligible for the ${d.name} bonus?`,
        answer: eligibility,
      },
      {
        question: `How do I apply the ${d.name} promo code?`,
        answer: `Start sign-up through our referral link (the code is usually pre-filled), or enter ${d.referral!.code} manually at sign-up, then complete the required verification and make a first top-up.`,
      },
      {
        question: `When does the ${d.name} offer expire?`,
        answer: expiryLabel,
      },
      {
        question: `Is there a ${d.name} referral code as well as a coupon?`,
        answer: `Yes — the referral code and promo code are the same: ${d.referral!.code}. Referrals reward both the new user and, where the programme allows, the referrer.`,
      },
    ]
  : [
      {
        question: `Does the ${d.name} have a promo code?`,
        answer: `We have not verified a current promo code, coupon or referral bonus for the ${d.name}. When one is confirmed it will be listed on this page.`,
      },
      {
        question: `Does the ${d.name} offer cashback or rewards?`,
        answer: d.rewards?.cashback
          ? `Tracked rewards: ${d.rewards.cashback}. Rates are set by the provider and can change.`
          : 'No rewards programme has been confirmed for this card yet.',
      },
    ];

const offerSchema = hasOffer
  ? {
      '@context': 'https://schema.org',
      '@type': 'Offer',
      name: `${d.name} promo code ${d.referral!.code}`,
      description: d.referral!.bonus,
      url: `https://cryptocards.biz/coupons/${d.slug}`,
      price: 0,
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      validFrom: formatIsoDate(d.lastVerified),
      ...(expiryDate ? { validThrough: expiryDate.toISOString() } : {}),
      seller: { '@type': 'Organization', name: d.company },
      itemOffered: { '@type': 'Service', name: d.name },
    }
  : null;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const schemas = [...(offerSchema ? [offerSchema] : []), faqSchema];
---

<BaseLayout
  title={`${d.name} Promo Codes & Coupons 2026`}
  description={
    hasOffer
      ? `Current ${d.name} promo code, coupon and referral bonus. See what code ${d.referral!.code} gives you, who is eligible, how to apply it, expiry and terms.`
      : `${d.name} promo codes, coupons and referral bonuses. See the latest verified offers, eligibility and how to apply them.`
  }
  image={`/og/${d.slug}.png`}
  modifiedTime={d.lastVerified}
  noindex={!d.verified}
  schemas={schemas}
>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Coupons', href: '/coupons' },
      { label: d.name },
    ]}
  />

  <div class="container-page mt-6 space-y-10">
    <header class="card-surface p-6">
      <div class="flex items-center gap-4">
        <CardLogo src={d.logo} name={d.name} color={d.brandColor} size={52} />
        <div>
          <h1 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl dark:text-white">
            {d.name} promo codes & coupons
          </h1>
          <p class="text-sm text-slate-500 dark:text-slate-400">
            {hasOffer ? d.referral!.bonus : 'No verified offer at this time.'}
          </p>
        </div>
      </div>

      {
        hasOffer && (
          <div class="mt-6">
            <CopyCodeButton code={d.referral!.code} client:load />
          </div>
        )
      }

      <div class="mt-6 flex flex-wrap items-center gap-4">
        {hasOffer && <CtaButton slug={d.slug} label="Claim the bonus" variant="accent" />}
        <a
          href={`/cards/${d.slug}`}
          class="text-sm font-medium text-brand-600 hover:underline dark:text-brand-400"
        >
          Read the {d.name} review →
        </a>
        <a
          href={`/cards/${d.slug}/countries`}
          class="text-sm font-medium text-brand-600 hover:underline dark:text-brand-400"
        >
          Available countries →
        </a>
      </div>
      <p class="mt-4 text-xs text-slate-400">Last verified {formatDate(d.lastVerified)}</p>
    </header>

    <Disclosure />

    <section>
      <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
        Current {d.name} offer
      </h2>
      {
        hasOffer ? (
          <>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              <div class="card-surface p-5">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                  Promo / referral code
                </p>
                <p class="mt-1 font-mono text-lg font-bold text-slate-900 dark:text-white">
                  {d.referral!.code}
                </p>
              </div>
              <div class="card-surface p-5">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Offer</p>
                <p class="mt-1 text-sm font-medium text-slate-900 dark:text-white">
                  {d.referral!.bonus}
                </p>
              </div>
            </div>
            {whatYouGet.length > 0 && (
              <ul class="mt-4 space-y-2 text-sm text-slate-600 dark:text-slate-300">
                {whatYouGet.map((item) => (
                  <li class="flex gap-2">
                    <span class="text-emerald-600 dark:text-emerald-400" aria-hidden="true">+</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}
          </>
        ) : (
          <p class="mt-3 max-w-3xl text-sm text-slate-600 dark:text-slate-300">
            We have not verified a current promo code, coupon or referral bonus for the {d.name}. We
            only list offers we can confirm — check back, or browse our other{' '}
            <a href="/coupons" class="text-brand-600 hover:underline dark:text-brand-400">
              crypto card coupons
            </a>.
          </p>
        )
      }
    </section>

    <section>
      <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">Eligibility</h2>
      <p class="mt-3 max-w-3xl text-sm text-slate-600 dark:text-slate-300">{eligibility}</p>
    </section>

    <section>
      <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
        {hasOffer ? `How to apply the ${d.name} promo code` : `How to get the ${d.name}`}
      </h2>
      <ol class="mt-4 space-y-4">
        {
          steps.map((step, index) => (
            <li class="flex gap-4">
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-brand-600 text-sm font-bold text-white">
                {index + 1}
              </span>
              <p class="pt-1 text-slate-600 dark:text-slate-300">{step}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section>
      <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
        Validity & expiration
      </h2>
      <p class="mt-3 max-w-3xl text-sm text-slate-600 dark:text-slate-300">
        <strong>Status:</strong> {expiryLabel}
      </p>
    </section>

    <section>
      <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
        Important terms
      </h2>
      <div class="mt-3 rounded-lg border border-slate-200 bg-slate-50 p-5 text-sm text-slate-600 dark:border-slate-800 dark:bg-slate-900/50 dark:text-slate-300">
        <p>
          {d.referral?.terms ??
            'Bonuses are set by the provider and can change at any time.'}
        </p>
        <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">
          Bonuses are offered by {d.company}, not by CryptoCards.biz. Eligibility, amount and timing
          are controlled by {d.company} and may vary by region. We may earn a commission when you use
          our link.
        </p>
      </div>
    </section>

    <section>
      <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
        Alternative offers & referral options
      </h2>
      {
        d.referral && d.referral.alternatives.length > 0 ? (
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {d.referral.alternatives.map((alt) => (
              <li class="card-surface p-4 text-sm">
                <a
                  href={alt.url}
                  rel="sponsored nofollow noopener"
                  target="_blank"
                  class="font-medium text-brand-600 hover:underline dark:text-brand-400"
                >
                  {alt.label}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-3 max-w-3xl text-sm text-slate-600 dark:text-slate-300">
            {hasOffer
              ? `The referral code above is the current documented offer for the ${d.name}.`
              : `There is no current offer for the ${d.name} that we can verify.`}{' '}
            Browse our other{' '}
            <a href="/coupons" class="text-brand-600 hover:underline dark:text-brand-400">
              crypto card coupons
            </a>{' '}
            for alternative offers.
          </p>
        )
      }
    </section>

    <section>
      <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
        Fees you should know about
      </h2>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
        The bonus is only worth it if the ongoing fees suit your spending. Here is the summary.
      </p>
      <div class="mt-4">
        <FeesTable fees={d.fees} limits={d.limits} rewards={d.rewards} />
      </div>
    </section>

    <section>
      <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
        {d.name} promo code FAQ
      </h2>
      <div class="mt-4 space-y-3">
        {
          faq.map((item) => (
            <details class="card-surface p-4">
              <summary class="cursor-pointer font-semibold text-slate-900 dark:text-white">
                {item.question}
              </summary>
              <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </section>

    {
      hasOffer && (
        <section class="rounded-xl border border-brand-200 bg-brand-50 p-6 dark:border-brand-900 dark:bg-brand-950/40">
          <h2 class="text-lg font-bold text-slate-900 dark:text-white">
            Ready to use the {d.name} promo code?
          </h2>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
            Code <strong class="font-mono">{d.referral!.code}</strong> — {d.referral!.bonus}
          </p>
          <div class="mt-4">
            <CtaButton slug={d.slug} label="Claim the bonus" variant="accent" />
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
