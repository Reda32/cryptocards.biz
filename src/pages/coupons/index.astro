---
import BaseLayout from '@/components/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CardLogo from '@/components/CardLogo.astro';
import { getAllCards } from '@/lib/cards';

const cards = (await getAllCards()).filter((card) => card.data.referral);
---

<BaseLayout
  title="Crypto Card Referral Codes & Bonuses"
  description="Current referral codes and sign-up bonuses for the crypto cards we review, with the steps and terms you need to qualify."
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Coupons' }]} />
  <div class="container-page mt-6">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
      Referral codes & bonuses
    </h1>
    <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-300">
      We only list codes we can verify. Each page explains exactly what the bonus requires, so you
      know whether it is worth completing KYC before you start.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        cards.length > 0 ? (
          cards.map((card) => (
            <article class="card-surface flex flex-col gap-4 p-5">
              <div class="flex items-center gap-3">
                <CardLogo src={card.data.logo} name={card.data.name} color={card.data.brandColor} size={44} />
                <div>
                  <h2 class="font-bold text-slate-900 dark:text-white">{card.data.name}</h2>
                  <p class="text-sm text-slate-500 dark:text-slate-400">{card.data.referral!.bonus}</p>
                </div>
              </div>
              <div class="mt-auto flex items-center gap-3">
                <code class="rounded border border-dashed border-slate-300 px-2 py-1 font-mono text-sm dark:border-slate-600">
                  {card.data.referral!.code}
                </code>
                <a href={`/coupons/${card.data.slug}`} class="btn-secondary ml-auto">
                  View details
                </a>
              </div>
            </article>
          ))
        ) : (
          <div class="card-surface p-6 sm:col-span-2">
            <p class="text-slate-600 dark:text-slate-300">
              We don't have any verified promo codes or referral bonuses right now. We only list
              offers we can confirm — check back, or browse the cards and their official sign-up
              links.
            </p>
            <a href="/cards" class="btn-primary mt-4">Browse all cards</a>
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>
