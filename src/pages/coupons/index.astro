---
import BaseLayout from '@/components/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CardLogo from '@/components/CardLogo.astro';
import CardSummaryRow from '@/components/CardSummaryRow.astro';
import { getAllCards, getAllCommunities } from '@/lib/cards';

const [cards, communities] = await Promise.all([getAllCards(), getAllCommunities()]);

const offers = cards.filter((card) => card.data.referral);
const feed = cards.slice(0, 12);

const scoreFor = (slug: string) =>
  communities.find((c) => c.data.cardSlug === slug)?.data.score ?? null;
---

<BaseLayout
  title="Crypto Card Offers, Referral Codes & Bonuses (2026)"
  description="Verified promo codes, referral bonuses and current offers for the crypto cards we review — plus a feed of every card with fees, limits and its official sign-up link."
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Coupons' }]} />
  <div class="container-page mt-6 space-y-10">
    <header>
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
        Crypto card offers, referral codes &amp; bonuses
      </h1>
      <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-300">
        We list promo codes and referral bonuses we can verify, and explain exactly what each one
        requires. Below that you'll find a feed of the crypto cards we cover, each with its official
        sign-up link.
      </p>
    </header>

    {
      offers.length > 0 && (
        <section>
          <h2 class="mb-4 text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
            Current offers
          </h2>
          <div class="grid gap-4 sm:grid-cols-2">
            {offers.map((card) => (
              <article class="card-surface flex flex-col gap-4 p-5">
                <div class="flex items-center gap-3">
                  <CardLogo src={card.data.logo} name={card.data.name} color={card.data.brandColor} size={44} />
                  <div>
                    <h3 class="font-bold text-slate-900 dark:text-white">{card.data.name}</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400">{card.data.referral!.bonus}</p>
                  </div>
                </div>
                <div class="mt-auto flex items-center gap-3">
                  <code class="rounded border border-dashed border-slate-300 px-2 py-1 font-mono text-sm dark:border-slate-600">
                    {card.data.referral!.code}
                  </code>
                  <a href={`/coupons/${card.data.slug}`} class="btn-secondary ml-auto">
                    View details
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>
      )
    }

    <section>
      <div class="mb-6 flex items-end justify-between">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Crypto cards</h2>
        <a href="/cards" class="text-sm font-medium text-brand-600 hover:underline dark:text-brand-400">
          View all {cards.length} cards
        </a>
      </div>
      <div class="space-y-4">
        {feed.map((card) => <CardSummaryRow card={card} communityScore={scoreFor(card.data.slug)} />)}
      </div>
    </section>
  </div>
</BaseLayout>
