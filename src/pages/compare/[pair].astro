---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CardLogo from '@/components/CardLogo.astro';
import CtaButton from '@/components/CtaButton.astro';
import CompareToggle from '@/components/CompareToggle.astro';
import FaqSection from '@/components/FaqSection.astro';
import { KYC_LABELS, percent, usd, type Card } from '@/lib/cards';
import { CURATED_PAIRS, pairSlug } from '@/lib/pairs';

export async function getStaticPaths() {
  const cards = await getCollection('cards');
  const paths = [];
  for (const pair of CURATED_PAIRS) {
    const cardA = cards.find((c) => c.data.slug === pair.a);
    const cardB = cards.find((c) => c.data.slug === pair.b);
    if (cardA && cardB) {
      paths.push({
        params: { pair: pairSlug(pair.a, pair.b) },
        props: { a: cardA, b: cardB },
      });
    }
  }
  return paths;
}

const { a, b } = Astro.props as { a: Card; b: Card };
const A = a.data;
const B = b.data;

interface Metric {
  label: string;
  aText: string;
  bText: string;
  aValue: number;
  bValue: number;
  best: 'high' | 'low' | 'none';
}

const metrics: Metric[] = [
  {
    label: 'Editorial score',
    aText: A.rating.toFixed(1),
    bText: B.rating.toFixed(1),
    aValue: A.rating,
    bValue: B.rating,
    best: 'high',
  },
  {
    label: 'Monthly fee',
    aText: usd(A.fees.monthly),
    bText: usd(B.fees.monthly),
    aValue: A.fees.monthly,
    bValue: B.fees.monthly,
    best: 'low',
  },
  {
    label: 'Issuance fee',
    aText: usd(A.fees.issuance),
    bText: usd(B.fees.issuance),
    aValue: A.fees.issuance,
    bValue: B.fees.issuance,
    best: 'low',
  },
  {
    label: 'FX markup',
    aText: percent(A.fees.fx),
    bText: percent(B.fees.fx),
    aValue: A.fees.fx,
    bValue: B.fees.fx,
    best: 'low',
  },
  {
    label: 'Cryptocurrencies',
    aText: `${A.cryptos.length} coins`,
    bText: `${B.cryptos.length} coins`,
    aValue: A.cryptos.length,
    bValue: B.cryptos.length,
    best: 'high',
  },
  {
    label: 'Countries supported',
    aText: `${A.countries.length}`,
    bText: `${B.countries.length}`,
    aValue: A.countries.length,
    bValue: B.countries.length,
    best: 'high',
  },
];

const kycRank = { none: 0, basic: 1, id: 2, full: 3 } as const;
const kycMetric: Metric = {
  label: 'KYC requirement',
  aText: KYC_LABELS[A.kyc.level],
  bText: KYC_LABELS[B.kyc.level],
  aValue: kycRank[A.kyc.level],
  bValue: kycRank[B.kyc.level],
  best: 'low',
};
metrics.push(kycMetric);

const winners = (metric: Metric): 0 | 1 | null => {
  if (metric.best === 'none' || metric.aValue === metric.bValue) return null;
  if (metric.best === 'high') return metric.aValue > metric.bValue ? 0 : 1;
  return metric.aValue < metric.bValue ? 0 : 1;
};

const aWins = metrics.filter((m) => winners(m) === 0).length;
const bWins = metrics.filter((m) => winners(m) === 1).length;

const verdictWinner = aWins === bWins ? (A.rating >= B.rating ? A : B) : aWins > bWins ? A : B;
const verdictLoser = verdictWinner === A ? B : A;

const verdict = `${verdictWinner.name} wins ${Math.max(aWins, bWins)} of ${metrics.length} categories. It scores ${verdictWinner.rating.toFixed(1)}/10 overall against ${verdictLoser.rating.toFixed(1)}/10 for ${verdictLoser.name}, and is the better pick for most people — though ${verdictLoser.name} remains strong where it wins below.`;

const faq = [
  {
    question: `Is ${A.name} or ${B.name} better?`,
    answer: verdict,
  },
  {
    question: `Which is cheaper, ${A.name} or ${B.name}?`,
    answer: `${A.name} charges a ${percent(A.fees.fx)} FX markup with a ${usd(A.fees.monthly)} monthly fee and ${usd(A.fees.issuance)} issuance cost. ${B.name} charges a ${percent(B.fees.fx)} FX markup with a ${usd(B.fees.monthly)} monthly fee and ${usd(B.fees.issuance)} issuance cost. Lower fees are highlighted in the table above.`,
  },
  {
    question: `Which has the easier sign-up, ${A.name} or ${B.name}?`,
    answer: `${A.name} requires ${KYC_LABELS[A.kyc.level]}, while ${B.name} requires ${KYC_LABELS[B.kyc.level]}. If minimising verification matters, choose the lower tier — but check the limits that apply before KYC.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout
  title={`${A.name} vs ${B.name} 2026: Fees, Limits & Cashback Compared`}
  description={`${A.name} vs ${B.name} compared: fees, limits, KYC requirements, supported coins and cashback. See which crypto card is better for you.`}
  image="/og/default.png"
  modifiedTime={A.lastVerified}
  schemas={[faqSchema]}
>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Compare', href: '/compare' },
      { label: `${A.name} vs ${B.name}` },
    ]}
  />

  <div class="container-page mt-6 space-y-10">
    <header>
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
        {A.name} vs {B.name}
      </h1>
      <p class="mt-3 max-w-3xl text-slate-600 dark:text-slate-300">
        {A.name} and {B.name} are two of the most popular crypto cards. We compare them on the things
        that actually affect your spending: fees, limits, KYC requirements and supported coins. Data
        last verified {A.lastVerified.toISOString().slice(0, 10)}.
      </p>
    </header>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        [a, b].map((card) => (
          <div class="card-surface p-5">
            <div class="flex items-center gap-3">
              <CardLogo src={card.data.logo} name={card.data.name} color={card.data.brandColor} size={48} />
              <div>
                <h2 class="font-bold text-slate-900 dark:text-white">{card.data.name}</h2>
                <p class="text-sm text-slate-500 dark:text-slate-400">
                  {card.data.company} · {card.data.rating.toFixed(1)}/10
                </p>
              </div>
            </div>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">{card.data.summary}</p>
            <div class="mt-4 flex flex-wrap items-center gap-3">
              <CtaButton slug={card.data.slug} label="Get card" />
              <CompareToggle slug={card.data.slug} label="Add to compare" />
              <a
                href={`/cards/${card.data.slug}`}
                class="text-sm font-medium text-brand-600 hover:underline dark:text-brand-400"
              >
                Review →
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <section class="card-surface overflow-x-auto">
      <table class="w-full min-w-[560px] text-sm">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-50 text-left dark:border-slate-800 dark:bg-slate-900/50">
            <th class="px-5 py-3 font-medium text-slate-500">Feature</th>
            <th class="px-5 py-3 font-bold text-slate-900 dark:text-white">{A.name}</th>
            <th class="px-5 py-3 font-bold text-slate-900 dark:text-white">{B.name}</th>
          </tr>
        </thead>
        <tbody>
          {
            metrics.map((metric) => (
              <tr class="border-b border-slate-100 last:border-0 dark:border-slate-800/60">
                <td class="px-5 py-2.5 text-slate-500 dark:text-slate-400">{metric.label}</td>
                <td
                  class:list={[
                    'px-5 py-2.5',
                    winners(metric) === 0 && 'bg-emerald-50 font-semibold text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300',
                  ]}
                >
                  {metric.aText}
                </td>
                <td
                  class:list={[
                    'px-5 py-2.5',
                    winners(metric) === 1 && 'bg-emerald-50 font-semibold text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300',
                  ]}
                >
                  {metric.bText}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="card-surface p-6">
      <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">Our verdict</h2>
      <p class="mt-3 text-slate-600 dark:text-slate-300">{verdict}</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <CtaButton slug={verdictWinner.slug} label={`Get ${verdictWinner.name}`} variant="accent" />
        <a href="/compare" class="btn-secondary">Compare interactively</a>
      </div>
    </section>

    <section>
      <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
        Frequently asked questions
      </h2>
      <div class="mt-4">
        <FaqSection items={faq} schema={false} />
      </div>
    </section>
  </div>
</BaseLayout>
