---
import AdminLayout from '@/components/admin/AdminLayout.astro';
import {
  adminEnabled,
  hasValidSession,
  isLockedOut,
  startSession,
  verifyPassword,
} from '@/lib/admin/auth';
import { TURNSTILE_ACTION, turnstileSiteKey, verifyTurnstile } from '@/lib/admin/turnstile';

export const prerender = false;

if (hasValidSession(Astro.cookies)) return Astro.redirect('/admin', 303);

let clientId = 'unknown';
try {
  clientId = Astro.clientAddress;
} catch {}

const siteKey = turnstileSiteKey();

let error = '';
if (!adminEnabled()) {
  error = 'The admin panel is disabled. Set ADMIN_PASSWORD (12+ characters) and restart the app.';
} else if (Astro.request.method === 'POST') {
  if (isLockedOut(clientId)) {
    error = 'Too many failed attempts. Try again in 15 minutes.';
  } else {
    const form = await Astro.request.formData();
    const human =
      !siteKey || (await verifyTurnstile(String(form.get('cf-turnstile-response') ?? ''), clientId));
    if (!human) {
      error = 'Human check failed. Complete the Cloudflare check and try again.';
    } else if (verifyPassword(String(form.get('password') ?? ''), clientId)) {
      startSession(Astro.cookies, import.meta.env.PROD);
      return Astro.redirect('/admin', 303);
    } else {
      error = 'Wrong password.';
    }
  }
}
---

<AdminLayout title="Log in" signedIn={false}>
  <div class="card-surface mx-auto max-w-sm p-6">
    <h1 class="text-xl font-bold text-slate-900 dark:text-white">Admin login</h1>
    {
      error && (
        <p class="mt-4 rounded-lg bg-rose-50 p-3 text-sm text-rose-700 dark:bg-rose-950/50 dark:text-rose-300">
          {error}
        </p>
      )
    }
    {
      adminEnabled() && (
        <form method="post" class="mt-4 space-y-4">
          <label class="block text-sm font-medium text-slate-700 dark:text-slate-300">
            Password
            <input
              type="password"
              name="password"
              required
              autocomplete="current-password"
              autofocus
              class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-950"
            />
          </label>
          {siteKey && <div id="turnstile" class="min-h-[65px]" />}
          <button type="submit" class="btn-primary w-full">
            Log in
          </button>
        </form>
      )
    }
  </div>
  {
    siteKey && (
      <>
        <script is:inline define:vars={{ siteKey, action: TURNSTILE_ACTION }}>
          window.onTurnstileLoad = () =>
            window.turnstile.render('#turnstile', {
              sitekey: siteKey,
              action,
              theme: 'auto',
              size: window.innerWidth < 400 ? 'compact' : 'normal',
            });
        </script>
        <script
          is:inline
          src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad"
          async
          defer
        />
      </>
    )
  }
</AdminLayout>
